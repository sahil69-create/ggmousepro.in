{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(style\\.css|auth\\.js|script\\.js|ecommerce\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/home", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/signup.html", "destination": "/signup", "permanent": true },
    { "source": "/store.html", "destination": "/store", "permanent": true },
    { "source": "/cart.html", "destination": "/cart", "permanent": true },
    { "source": "/legal.html", "destination": "/legal", "permanent": true },
    { "source": "/checkout.html", "destination": "/checkout", "permanent": true },
    { "source": "/order-confirmation.html", "destination": "/order-confirmation", "permanent": true },
    { "source": "/account.html", "destination": "/account", "permanent": true }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/store", "destination": "/store.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/order-confirmation", "destination": "/order-confirmation.html" },
    { "source": "/account", "destination": "/account.html" }
  ]
}
